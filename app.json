{
  "expo": {
    "name": "Bongo Stream",
    "slug": "combongostreamapp",
    "backgroundColor": "#0A0A0F",
    "version": "1.0.3",
    "scheme": "bongo-stream",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bongostream.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSMicrophoneUsageDescription": "Bongo Stream uses the microphone to record your vocals and voice samples.",
        "NSCameraUsageDescription": "Bongo Stream uses the camera to scan lyrics and take cover photos.",
        "NSPhotoLibraryUsageDescription": "Bongo Stream needs access to your photos to set cover art and profile pictures.",
        "NSPhotoLibraryAddUsageDescription": "Bongo Stream saves share cards and cover art to your photos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "backgroundColor": "#0A0A0F",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.bongostream.app",
      "versionCode": 4,
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-document-picker",
      [
        "expo-audio",
        {
          "microphonePermission": "Bongo Stream uses the microphone to record your vocals and voice samples.",
          "enableBackgroundPlayback": true
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.swmansion.reanimated.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n-keep class expo.modules.** { *; }\n-keep class io.sentry.** { *; }\n-dontwarn io.sentry.**"
          }
        }
      ],
      "@sentry/react-native/expo",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9c00d08b-2002-4e17-9e2a-40dc7d8ba6a2"
      }
    }
  }
}
